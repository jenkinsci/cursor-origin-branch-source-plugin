<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="${%Name}" field="name">
    <f:textbox default="Jenkins"/>
  </f:entry>
  <f:entry title="${%Skip publishing checks}" field="skip">
    <f:checkbox/>
  </f:entry>
  <f:entry title="${%Report unstable builds as neutral}" field="unstableBuildNeutral">
    <f:checkbox/>
  </f:entry>
  <f:entry title="${%Suppress logs}" field="suppressLogs">
    <f:checkbox/>
  </f:entry>
  <f:entry title="${%Skip progress updates}" field="skipProgressUpdates">
    <f:checkbox/>
  </f:entry>
  <f:entry title="${%Verbose console log}" field="verboseConsoleLog">
    <f:checkbox/>
  </f:entry>
</j:jelly>
